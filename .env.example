# ---- HTTP ----
PORT=3050
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth (SECRET_KEY is REQUIRED) ----
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_EXPIRES_IN=60d

# ---- API versioning ----
# All routes live under /api/v1. Keep the old unversioned paths (/login, /:soeid/workspaces, ...) as
# deprecated aliases until every client has migrated, then set this to false.
LEGACY_UNVERSIONED_ROUTES=true

# ---- OpenShift / Kubernetes ----
# Cluster API URL, used only to derive the cluster name for emails
CLUSTER_API_URL=https://api.mycluster.ecs.dyn.example.net:6443
# Optional kubeconfig path; when empty the in-cluster service account is used
KUBECONFIG_PATH=
# Namespace-creation label/annotation contract with Dev Spaces
DEPLOY_PROJECT_REQUESTER=devspaces-support-team
DEV_SPACES_SERVICE_FQDN=https://devspaces.apps.mycluster.example.net

# ---- Devfile registry ----
DEVREG_URL=http://devfile-registry.openshift-devspaces.svc:8080
# Editor ids as understood by the Dev Spaces dashboard (che-incubator/<id>/latest)
EDITOR_VSCODE=che-code
EDITOR_INTELLIJ=che-idea
# Outbound proxy injected into user workspaces (empty = do not inject)
WORKSPACE_PROXY_URL=

# ---- Limits per user ----
MAX_RUNNING_WORKSPACES=3
MAX_TOTAL_WORKSPACES=5

# ---- Postgres (metrics) ----
POSTGRES_ENABLED=true
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=devspaces_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false
# Path to CA bundle when POSTGRES_SSL=true
POSTGRES_CA_FILE=
POSTGRES_DATABASE_TABLENAME=metrics."devspaces-metrics"

# ---- Notifications (optional) ----
NOTIFICATION_MAIL_URL=
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_SENDER=noreply@example.com
NOTIFICATION_CC=
EMAIL_DOMAIN=example.com
USER_DIRECTORY_GRAPHQL_URL=

# ---- GitHub personal access tokens stored for Dev Spaces ----
GITHUB_URL=https://github.com
# Appended to the soeid to form the git username, e.g. _citi → pp58386_citi (empty = soeid only)
GITHUB_USER_SUFFIX=
