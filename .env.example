# ---- HTTP ----
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth (SECRET_KEY is REQUIRED) ----
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-16-chars
ADMIN_USERNAME=orion-devspaces
ADMIN_PASSWORD=change-me
JWT_EXPIRES_IN=60d

# ---- API versioning ----
# All routes live under /api/v1. Keep the old unversioned paths (/login, /:soeid/workspaces, ...) as
# deprecated aliases until every client has migrated, then set this to false.
LEGACY_UNVERSIONED_ROUTES=true

# ---- OpenShift clusters ----
# Dev Spaces cluster. The bearer token is found by NAME: devSpacesClusterToken<id>, where <id> is the end of the
# cluster name in the URL (namctigtd001d -> 001d). A token whose id belongs to another cluster is ignored.
CLUSTER_API_URL=https://api.namctigtd001d.ecs.dyn.nsroot.net:6443
devSpacesClusterToken001d=change-me
# Build/deploy projects live on this cluster; leave it unset (as today) to use the Dev Spaces cluster for them too.
# Its token is devOpsToken<id> (namctiswd004d -> 004d). With it unset, devOpsToken004d below is NOT used.
# DEPLOY_CLUSTER_API_URL=https://api.namctiswd004d.ecs.dyn.nsroot.net:6443
devOpsToken004d=change-me
# Explicit tokens (win over the by-name lookup) and a kubeconfig file (also the first command-line argument):
# CLUSTER_TOKEN=
# DEPLOY_CLUSTER_TOKEN=
# KUBECONFIG_PATH=
# NODE_TLS_REJECT_UNAUTHORIZED=0 turns certificate checking OFF for the clusters and every other HTTPS peer
# (the service logs a warning at startup). Prefer fixing the trust store; keep it only where it is needed.
NODE_TLS_REJECT_UNAUTHORIZED=0
DEPLOY_PROJECT_REQUESTER=devspaces-support-team
# Dev Spaces dashboard address; when unset it is https://devspaces.apps.<cluster domain> taken from CLUSTER_API_URL.
# DEV_SPACES_SERVICE_FQDN=https://devspaces.apps.namctigtd001d.ecs.dyn.nsroot.net

# ---- Devfile registry ----
DEVREG_URL=https://devreg-service-cti-svcs-devfile-registry-177398.apps.namctigtd001d.ecs.dyn.nsroot.net
# Editors as the Dev Spaces dashboard knows them: the full id publisher/name/version.
EDITOR_VSCODE=che-incubator/che-code/latest
EDITOR_INTELLIJ=che-incubator/che-idea-server/latest
# EDITOR_GOLAND=che-incubator/che-goland/latest
# Outbound proxy injected into user workspaces (empty = do not inject)
WORKSPACE_PROXY_URL=

# ---- Limits per user ----
MAX_RUNNING_WORKSPACES=3
MAX_TOTAL_WORKSPACES=5

# ---- Postgres: the EXISTING Orion metrics database ----
# workspace-mgr only INSERTs rows into the table below. It never creates, alters or drops anything:
# the database, user and table must already exist. These are the same variable names as before; with
# `export X='...'` the quotes are removed by the shell, and quotes left in a .env file are removed here too.
POSTGRES_DATABASE=orion_dev_metadata
POSTGRES_HOSTNAME=NAORI01DPS_INSTANCE1.pgaas.dyn.nsroot.net
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=1524
POSTGRES_USER=app_orion_pgsql_dev
POSTGRES_DATABASE_TABLENAME=metrics."devspaces-metrics-dev"
# NODE_ENV (set above) chooses the CA certificate, exactly as the original service did:
#   development -> ./certs/dev.pem   (hostname check relaxed, certificate still verified)
#   uat         -> /app/backend/cert/uat.pem
#   production  -> /app/backend/cert/prod.pem
# Optional overrides:
# POSTGRES_CERT_DIR=/some/dir          (directory holding dev.pem / uat.pem / prod.pem)
# POSTGRES_CA_FILE=/some/dir/ca.pem    (one specific CA file; wins over the above)
# POSTGRES_SSL=false                   (TLS is ON by default; only turn it off for a local test database)
# POSTGRES_ENABLED=false               (do not write metrics at all, e.g. when running without a database)

# ---- Notifications (optional) ----
NOTIFICATION_MAIL_URL=
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_SENDER=noreply@example.com
NOTIFICATION_CC=
EMAIL_DOMAIN=example.com
USER_DIRECTORY_GRAPHQL_URL=

# ---- GitHub personal access tokens stored for Dev Spaces ----
GITHUB_URL=https://github.com
# Appended to the soeid to form the git username, e.g. _citi → pp58386_citi (empty = soeid only)
GITHUB_USER_SUFFIX=
